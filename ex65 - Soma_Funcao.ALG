Algoritmo "Somar dois numeros"
Var
   x, y: real
   s: real
Funcao Soma(a, b: real) : real
var
inicio
      retorne x + y
FimFuncao

Inicio
      escreva ("Digite um numero: ")
      leia (x)
      escreva ("Digite mais um numero: ")
      leia (y)
      s <- Soma(x, y)
      escreva (x, " + ", y, " = ", s)
Fimalgoritmo